# Copy this file to Backend/.env (it is git-ignored) and fill in your values.

PORT=5000

# PostgreSQL connection string. For Supabase: Dashboard -> "Connect" button -> "Session pooler" string,
# then replace [YOUR-PASSWORD] with your database password (use a password of only letters and digits,
# or special characters must be URL-encoded). Do NOT add ?sslmode=... to it; use DATABASE_SSL below.
# Local database example:  postgres://USER:PASSWORD@localhost:5432/kph
DATABASE_URL=

# off        = database on your own computer
# no-verify  = hosted database (Supabase etc.), encrypted but certificate not checked: development only
# verify     = hosted database, certificate checked: production (see DATABASE_SSL_CA_FILE)
DATABASE_SSL=no-verify
# Path to the database's CA certificate file (Supabase: download it from your project's database settings).
# Needed for DATABASE_SSL=verify with Supabase. Never commit the file if your provider says it is private.
DATABASE_SSL_CA_FILE=

# Same project ID as NEXT_PUBLIC_FIREBASE_PROJECT_ID in the frontend's .env.local.
# Token verification needs only this ID, NOT a service-account secret key.
FIREBASE_PROJECT_ID=kph-college

# Only Google accounts on this domain may use the API.
ALLOWED_EMAIL_DOMAIN=mail.jiit.ac.in

# Websites allowed to call this API from a browser (comma-separated).
CORS_ORIGIN=http://localhost:3000
