# Firebase web configuration (public by design). Copy this file to .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDPQilO7rTrmLHpZMfFgJzumCmWL4G7yvY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kph-college.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kph-college
NEXT_PUBLIC_FIREBASE_APP_ID=1:1085367743928:web:14a1117b543d5441f1cb4d

# Where the KPH backend runs (see Backend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Sharing your dev site through a tunnel (VS Code ports, ngrok...)? List the tunnel hostname(s) here, comma-separated.
# Also add the hostname in Firebase Console > Authentication > Settings > Authorized domains.
ALLOWED_DEV_ORIGINS=

# Only Google accounts on this domain can sign in. The backend enforces it too.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=mail.jiit.ac.in

# Server secrets never go in NEXT_PUBLIC_* variables or in this file.
